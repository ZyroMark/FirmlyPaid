{
  "openapi": "3.0.4",
  "info": {
    "title": "FirmlyPaid.Enrolment.Api",
    "description": "Agent-assisted enrolment: Home Affairs verification, POPIA consent, finger vein capture and PIN.",
    "contact": {
      "name": "ZYROMARK PTY LTD"
    },
    "version": "v1"
  },
  "paths": {
    "/enrolments": {
      "post": {
        "tags": [
          "Enrolment"
        ],
        "summary": "Verifies the customer with Home Affairs and records POPIA consent.",
        "operationId": "CreateEnrolment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEnrolmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEnrolmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/enrolments/{enrolmentId}/vein-samples": {
      "post": {
        "tags": [
          "Enrolment"
        ],
        "summary": "Takes three encrypted samples of one finger. A poor read comes back with a retry message.",
        "operationId": "SubmitVeinSamples",
        "parameters": [
          {
            "name": "enrolmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitVeinSamplesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitVeinSamplesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/enrolments/{enrolmentId}/complete": {
      "post": {
        "tags": [
          "Enrolment"
        ],
        "summary": "Sets the customer's PIN and makes the profile active.",
        "operationId": "CompleteEnrolment",
        "parameters": [
          {
            "name": "enrolmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteEnrolmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteEnrolmentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompleteEnrolmentRequest": {
        "type": "object",
        "properties": {
          "encryptedPin": {
            "$ref": "#/components/schemas/EncryptedPayloadDto"
          }
        },
        "additionalProperties": false
      },
      "CompleteEnrolmentResponse": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/CustomerStatus"
          }
        },
        "additionalProperties": false
      },
      "CreateEnrolmentRequest": {
        "type": "object",
        "properties": {
          "idNumber": {
            "type": "string",
            "nullable": true
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "cellphoneNumber": {
            "type": "string",
            "nullable": true
          },
          "agentId": {
            "type": "string",
            "format": "uuid"
          },
          "storeId": {
            "type": "string",
            "format": "uuid"
          },
          "consentTextVersion": {
            "type": "string",
            "nullable": true
          },
          "consentAccepted": {
            "type": "boolean"
          },
          "fingerprintSampleBase64": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateEnrolmentResponse": {
        "type": "object",
        "properties": {
          "enrolmentId": {
            "type": "string",
            "format": "uuid"
          },
          "homeAffairsResult": {
            "$ref": "#/components/schemas/HomeAffairsOutcome"
          },
          "homeAffairsReference": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CustomerStatus": {
        "enum": [
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "EncryptedPayloadDto": {
        "type": "object",
        "properties": {
          "ciphertextBase64": {
            "type": "string",
            "nullable": true
          },
          "keyVersion": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FingerPosition": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "type": "integer",
        "format": "int32"
      },
      "HomeAffairsOutcome": {
        "enum": [
          1,
          2,
          3,
          4
        ],
        "type": "integer",
        "format": "int32"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "SubmitVeinSamplesRequest": {
        "type": "object",
        "properties": {
          "fingerPosition": {
            "$ref": "#/components/schemas/FingerPosition"
          },
          "samples": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EncryptedPayloadDto"
            },
            "nullable": true
          },
          "qualityScores": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SubmitVeinSamplesResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "averageQualityScore": {
            "type": "integer",
            "format": "int32"
          },
          "fingersCaptured": {
            "type": "integer",
            "format": "int32"
          },
          "retryMessage": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Enrolment"
    }
  ]
}