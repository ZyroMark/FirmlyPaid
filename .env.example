# Copy this file to .env and set your own values. .env is git-ignored (rule 10.15:
# secrets never go in source control).
#
# SQL Server needs at least 8 characters with upper case, lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=ChangeMe_Local1!
RABBITMQ_USER=firmlypaid
RABBITMQ_PASSWORD=ChangeMe_Local1!

# Used to hash ID numbers before they are stored (rule 10.4). At least 32 characters.
# Generate your own, for example:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# Changing this makes every stored IdNumberHash unreadable, so set it once per environment.
FIRMLYPAID_ID_PEPPER=replace-me-with-at-least-32-random-characters
